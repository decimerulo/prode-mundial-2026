<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#020F2A">
  <title><%= typeof title !== 'undefined' ? title : 'Quiniela del Mundial 2026' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Barlow+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="/"><span class="brand-mark"></span><span class="brand-text">Quiniela Mundial 2026</span></a>
      <nav>
        <% if (currentUser) { %>
          <a href="/matches">Partidos</a>
          <a href="/betting">Apuestas</a>
          <a href="/betting/ranking">💰 Ranking $</a>
          <a href="/ranking">Ranking</a>
          <% if (currentUser.is_admin) { %><a href="/admin">Admin</a><% } %>
          <span class="user">👤 <%= currentUser.nickname %></span>
          <form action="/logout" method="post" style="display:inline">
            <button type="submit" class="link">Salir</button>
          </form>
        <a href="/instructions">Cómo se juega</a>
        <% } else { %>
          <a href="/login">Ingresar</a>
          <a href="/register">Registrarme</a>
          <a href="/instructions">Cómo se juega</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="container">
    <% if (flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.msg %></div>
    <% } %>
